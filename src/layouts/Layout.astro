---
import "@fontsource/poppins";
import Header from "../components/Header.astro";
import CalltoAction from "../components/CalltoAction.astro";
import Solution from "../components/Solution.astro";
import Ubicanos from "../components/Ubicanos.astro";
import Footer from "../components/Footer.astro";
import Interventions from "../components/Interventions.astro";
import Therapies from "../components/Therapies.astro";
import PlanCard from "../components/PlanCard.astro";
import Team from "../components/Team.astro";
import Questions from "../components/Questions.astro";
import Evidence from "../components/Evidence.astro";
import WeOffer from "../components/WeOffer.astro";

interface Props {
  title: string;
  description: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <title>{title}</title></head
  >
  <body class="flex flex-col items-center justify-center">
    <Header />

    <CalltoAction />
    <Solution />
    <Interventions />
    <Therapies />
    <WeOffer />
    <Team />
    <Questions />
    <PlanCard /> 
    <Evidence />
    <Ubicanos />
    <Footer />

    <slot />
    <style is:global>
      body {
        display: flex;
        flex-direction: column;
        background-image: url("../assets/fondo.webp");
        background-repeat: repeat;
        background-size: auto;
        background-position: top left;
        backdrop-filter: blur(5px);
      }
    </style>
  </body>
</html>
