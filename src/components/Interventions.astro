---
import { Image } from "astro:assets";
import evalPsic from "../assets/evalpsic.webp";
import psicIndi from "../assets/psicindi.webp";
import psicFami from "../assets/psicfami.webp";
import orientacion from "../assets/orientacion.webp";

// Definición de tipos para mejor mantenimiento
interface InterventionCard {
  title: string;
  imageSrc: ImageMetadata;
  alt: string;
}

// Datos estructurados para las tarjetas
const cards: InterventionCard[] = [
  {
    title: "Evaluación psicológica",
    imageSrc: evalPsic,
    alt: "Sesión de evaluación psicológica"
  },
  {
    title: "Psicoterapia individual",
    imageSrc: psicIndi,
    alt: "Terapia psicológica individual"
  },
  {
    title: "Psicoterapia familiar",
    imageSrc: psicFami,
    alt: "Terapia familiar grupal"
  },
  {
    title: "Orientación y consejería familiar",
    imageSrc: orientacion,
    alt: "Sesión de orientación familiar"
  }
];
---

<section class="container mx-auto px-4 mb-16">
  <h1 
    class="text-3xl sm:text-4xl font-semibold mb-10 text-center lg:text-left"
    transition:name="interventions-title"
  >
    Intervención Especializada
  </h1>

  <ul 
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"
    role="list"
  >
    {cards.map((card, index) => (
      <li 
        class="group"
        transition:name={`intervention-card-${index}`}
      >
        <div 
          class="relative rounded-3xl overflow-hidden shadow-lg transform-gpu hover:scale-[1.02] transition-transform duration-200"
        >
          <Image
            src={card.imageSrc}
            alt={card.alt}
            width={400}
            height={224}
            quality={80}
            loading={index <= 1 ? "eager" : "lazy"}
            decoding="async"
            class="w-full h-56 object-cover"
          />
          <div 
            class="absolute inset-0 bg-gradient-to-t from-black/70 to-black/30 flex items-center justify-center p-4"
          >
            <h2 
              class="text-white text-center text-lg sm:text-xl font-semibold"
              style="text-shadow: 0 2px 4px rgba(0,0,0,0.3);"
            >
              {card.title}
            </h2>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Optimizaciones de rendimiento */
  @media (prefers-reduced-motion: reduce) {
    .group {
      transform: none !important;
      transition: none !important;
    }
  }

  /* Optimización de imágenes */
  img {
    content-visibility: auto;
    contain-intrinsic-size: 400px 224px;
  }

  /* Optimización de rendering */
  .container {
    contain: content;
  }

  /* Mejorar rendimiento en hover */
  .group {
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Optimización de gradiente */
  .bg-gradient-to-t {
    background-image: linear-gradient(
      to top,
      rgba(0,0,0,0.7),
      rgba(0,0,0,0.3)
    );
  }
</style>