---
import { Image } from "astro:assets";
import cta from "../assets/calltoaction.webp";
---

<div class="flex flex-col md:flex-row items-center w-full max-w-7xl mb-20 px-4">
  <aside class="md:w-1/2 text-center md:text-left mb-6 md:mb-0">
    <h2 class="text-cyan-400 font-bold text-lg sm:text-xl">
      Experiencia y confianza
    </h2>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mt-2">
      Servicios psicológicos especializados de alta calidad
    </h1>
    <p class="text-gray-600 mt-4 text-base sm:text-lg leading-relaxed">
      Nuestro servicio y la eficiencia del trabajo de nuestros <br class="hidden md:block" />
      terapeutas son las razones de nuestro éxito.
    </p>
    <a
      href="https://wa.me/51937562487?text=Hola,%20me%20gustaría%20saber%20más%20sobre%20sus%20servicios"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contáctanos por WhatsApp"
      class="bg-blue-800 text-white mt-5 font-semibold px-6 py-3 rounded-full text-lg sm:text-xl inline-block transform hover:scale-105 hover:bg-blue-700 transition duration-300"
    >
      Contáctanos
    </a>
  </aside>

  <Image
    src={cta}
    alt="Call to action - Imagen representativa"
    quality={"high"}
    loading="lazy"
    class="w-full md:w-1/2 rounded-3xl shadow-lg"
  />
</div>
