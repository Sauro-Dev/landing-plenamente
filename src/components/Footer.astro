---
import Ubication from "./icons/Ubication.astro";
import Mail from "./icons/Mail.astro";
import Phone from "./icons/Phone.astro";
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";
import Facebook from "./icons/Facebook.astro";
import Instagram from "./icons/Instagram.astro";
import Tiktok from "./icons/Tiktok.astro";
---

<footer class="bg-blue-800 text-white py-8 w-full">
  <div
    class="container mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 items-center justify-items-center"
  >
 <!-- Columna Izquierda: Redes Sociales -->
<div class="flex flex-col space-y-4">
  <a 
    href="https://www.facebook.com/PlenaMenteTrujillo" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="flex items-center space-x-2 hover:opacity-80 transition-opacity"
  >
    <Facebook class="text-white size-6" />
    <div>
      <h2 class="text-white text-lg font-small">PlenaMenteTrujillo</h2>
    </div>
  </a>

  <a 
    href="https://www.instagram.com/plenamentetrujillo" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="flex items-center space-x-2 hover:opacity-80 transition-opacity"
  >
    <Instagram class="text-white size-6" />
    <div>
      <h2 class="text-white text-lg font-small">plenamentetrujillo</h2>
    </div>
  </a>

  <a 
    href="https://www.tiktok.com/@plenamentetrujillo" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="flex items-center space-x-2 hover:opacity-80 transition-opacity"
  >
    <Tiktok class="text-white size-6" />
    <div>
      <h2 class="text-white text-lg font-small">@plenamentetrujillo</h2>
    </div>
  </a>
</div>

    <!-- Columna Central: Logo y Frase -->
    <div class="flex flex-col items-center">
      <Image
        src={logo}
        alt="Logo de PLENAMente"
        width={80}
        height={80}
        quality={"high"}
        loading="lazy"
      />
      <h2 class="text-lg font-semibold">PLENA-Mente</h2>
      <p>Psicología Lenguaje</p>
      <p>Neuro Aprendizaje</p>
    </div>

    <!-- Columna Derecha: Contacto y Ubicación -->
<div class="flex flex-col items-start space-y-4">
  <div class="flex items-center space-x-2">
    <Mail class="text-white size-6" />
    <div>
      <h2 class="text-white text-lg font-small">Correo:</h2>
      <h3 class="text-white"><a href="mailto:plenamentetrujillo@gmail.com">plenamentetrujillo@gmail.com</a></h3>
    </div>
  </div>

  <div class="flex items-center space-x-2">
    <Phone class="text-white size-6" />
    <div>
      <h2 class="text-white text-lg font-small">Teléfono:</h2>
      <h3 class="text-white"><a href="tel:+51937562487">+51 937 562 487</a></h3>
    </div>
  </div>

  <div class="flex items-center space-x-2">
    <Ubication class="text-white size-6" />
    <div>
      <h2 class="text-white text-lg font-small">Ubicación:</h2>
      <h3 class="text-white"><a href="https://www.google.com/maps/place/Huayna+Capac+713,+Trujillo+13006/@-8.119933,-79.020635,17z/data=!4m6!3m5!1s0x91ad3d7e153855e9:0x4bf8c0efa53d7300!8m2!3d-8.1199332!4d-79.0206354!16s%2Fg%2F11fqsvyhb0?hl=es-419&entry=ttu&g_ep=EgoyMDI1MDEwOC4wIKXMDSoASAFQAw%3D%3D" target="_blank">Huayna Capac 713 Urb. Santa Maria</a></h3>
    </div>
  </div>
</div>

  </div>
</footer>
