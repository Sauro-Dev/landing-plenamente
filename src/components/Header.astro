---
import { Image } from "astro:assets";
import Mail from "./icons/Mail.astro";
import Phone from "./icons/Phone.astro";
import Ubication from "./icons/Ubication.astro";
import logo from "../assets/logo.webp";

// Datos estáticos
type ContactInfo = {
  location: string;
  email: string;
  phone: string;
}

const contactInfo: ContactInfo = {
  location: "Huayna Capac 713 Urb. Santa Maria",
  email: "plenamentetrujillo@gmail.com",
  phone: "+51 937 562 487"
};

// Definición de componentes para el menú
type MenuItemProps = {
  icon: typeof Mail | typeof Phone | typeof Ubication;
  title: string;
  info: string;
  className?: string;
}

const menuItems: MenuItemProps[] = [
  { icon: Ubication, title: "Ubicación", info: contactInfo.location },
  { icon: Mail, title: "Correo", info: contactInfo.email },
  { icon: Phone, title: "Teléfono", info: contactInfo.phone }
];
---

<header
  class="bg-blue-800 z-10 flex items-center justify-center h-24 w-full mb-20 relative"
>
  <div class="container mx-auto flex justify-between items-center px-4">
    <!--Logo y nombre -->
    <div class="flex items-center space-x-4">
      <Image
        src={logo}
        alt="Logo de PLENAMente"
        width={60}
        height={60}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <h1 class="text-white font-light text-xl md:text-3xl tracking-wide">
        PLENA-Mente
      </h1>
    </div>

    <!-- Menú móvil -->
    <div x-data="{ open: false }" class="lg:hidden">
      <button 
        @click="open = !open" 
        class="text-white focus:outline-none"
        aria-label="Menú"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-8 w-8"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16m-7 6h7"
          />
        </svg>
      </button>

      <!-- Menú móvil desplegable -->
      <nav
        x-show="open"
        @click.away="open = false"
        x-cloak
        class="absolute top-full left-0 right-0 mt-2 flex flex-col space-y-3 bg-blue-700 rounded-lg p-4 z-20 w-full"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-1"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-1"
      >
        {menuItems.map(({ icon: Icon, title, info }) => (
          <div class="flex items-center space-x-2">
            <Icon class="text-white h-6 w-6" />
            <div>
              <h2 class="text-white text-sm font-medium">{title}:</h2>
              <h3 class="text-white text-sm">{info}</h3>
            </div>
          </div>
        ))}
      </nav>
    </div>

    <!-- Menú desktop -->
    <nav class="hidden lg:flex space-x-8">
      {menuItems.map(({ icon: Icon, title, info }, index) => (
        <>
          <div class="flex items-center space-x-2">
            <Icon class="text-white size-8" />
            <div>
              <h2 class="text-white text-lg font-medium">{title}:</h2>
              <h3 class="text-white">{info}</h3>
            </div>
          </div>
          {index < menuItems.length - 1 && (
            <div class="w-px h-15 bg-white mx-4" />
          )}
        </>
      ))}
    </nav>
  </div>
</header>

<style>
  /* Estilos críticos */
  [x-cloak] { display: none !important; }
  
  /* Optimización de fuentes */
  @font-face {
    font-family: 'HeaderFont';
    font-display: swap;
    src: local('Arial'), local('Helvetica');
  }
</style>