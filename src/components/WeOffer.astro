---
import { Image } from "astro:assets";
import ofrecemos from "../assets/ofrecemos.webp";
import Compromiso from "./icons/Compromiso.astro";
import Paciencia from "./icons/Paciencia.astro";
import Honestidad from "./icons/Honestidad.astro";
import Respeto from "./icons/Respeto.astro";

// Datos de los valores para evitar repetición
const valores = [
  {
    icon: Compromiso,
    text: "Compromiso",
    bgColor: "bg-cyan-300"
  },
  {
    icon: Paciencia,
    text: "Paciencia",
    bgColor: "bg-cyan-400"
  },
  {
    icon: Honestidad,
    text: "Honestidad",
    bgColor: "bg-cyan-400"
  },
  {
    icon: Respeto,
    text: "Respeto",
    bgColor: "bg-cyan-300"
  }
];
---

<section class="py-16">
  <div class="container mx-auto max-w-7xl grid gap-12 md:gap-16 md:grid-cols-2 items-center px-4">
    {/* Columna Izquierda */}
    <div class="space-y-4 text-center md:text-left">
      <h2 class="text-cyan-500 font-bold text-lg">Que ofrecemos</h2>
      <div class="space-y-1">
        <h3 class="text-3xl sm:text-4xl font-semibold text-black">
          El mejor servicio a
        </h3>
        <h3 class="text-3xl sm:text-4xl font-semibold text-black">
          Nuestros Pacientes
        </h3>
      </div>
      <div class="flex justify-center md:justify-start mt-6">
        <Image
          src={ofrecemos}
          alt="Equipo Plenamente"
          width={400}
          height={300}
          quality={90}
          loading="eager"
          class="rounded-3xl shadow-lg border-4 border-cyan-400 w-full max-w-sm object-cover"
        />
      </div>
    </div>

    {/* Columna Derecha: Grid de Valores */}
    <div class="grid grid-cols-2 gap-6 sm:gap-8">
      {valores.map(({ icon: Icon, text, bgColor }) => (
        <div class="flex flex-col items-center text-center">
          <div 
            class={`w-32 h-32 sm:w-48 sm:h-48 ${bgColor} rounded-full flex items-center justify-center shadow-lg transform transition-transform duration-300 hover:scale-105`}
          >
            <div class="flex items-center justify-center space-x-2">
              <Icon class="w-8 h-8 sm:w-10 sm:h-10" />
              <span class="text-sm sm:text-xl font-normal text-black">
                {text}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Optimizaciones de rendimiento */
  @media (prefers-reduced-motion: reduce) {
    .transform {
      transform: none !important;
      transition: none !important;
    }
  }

  /* Optimización de sombras */
  .shadow-lg {
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Prevenir CLS */
  img {
    aspect-ratio: 4/3;
    content-visibility: auto;
  }
</style>